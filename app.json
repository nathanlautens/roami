{
  "expo": {
    "name": "Roami",
    "slug": "roami",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roami",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "backgroundColor": "#F3EFFF",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.nathanlautens.roami",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nathanlautens.roami",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "Roami checks your contacts so you can find friends who are already roaming. Nothing is uploaded except phone numbers to match."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a profile pic so your friends know it's you.",
          "cameraPermission": "Snap a profile pic so your friends know it's you."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b7acc4c5-6f8a-49e5-aef7-660d4bbb15ea"
      }
    }
  }
}
