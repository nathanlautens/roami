{
  "expo": {
    "name": "Roami",
    "slug": "roami",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roami",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "backgroundColor": "#F3EFFF",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.nathanlautens.roami",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nathanlautens.roami",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a profile pic so your friends know it's you.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Roami uses Face ID so you can get in without another email code."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Roami adds Roams you're in on to your calendar and shows what's already on when you're picking a night.",
          "remindersPermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b7acc4c5-6f8a-49e5-aef7-660d4bbb15ea"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b7acc4c5-6f8a-49e5-aef7-660d4bbb15ea",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
